rules_version = '2';

// Orlando Driver Hub: one owner per data tree. Everything else is denied.
//   users/{uid}/guides/guide_{YYYY-MM-DD}   cached weekly research
//   users/{uid}/shifts/{shiftId}            shift log
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function money(v) {
      return (v is int || v is float) && v >= 0 && v <= 100000;
    }

    function validGuide(d, guideId) {
      return d.keys().hasOnly(['weekOf', 'guideJson', 'sourcesJson', 'savedAt'])
        && d.keys().hasAll(['weekOf', 'guideJson', 'sourcesJson', 'savedAt'])
        && d.weekOf is string && d.weekOf.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && guideId == 'guide_' + d.weekOf
        && d.guideJson is string && d.guideJson.size() < 800000
        && d.sourcesJson is string && d.sourcesJson.size() < 100000
        && d.savedAt == request.time;
    }

    function validShift(d) {
      return d.keys().hasOnly(['start', 'end', 'platform', 'earnings', 'tips', 'trips', 'miles', 'tolls', 'areas', 'notes', 'updatedAt', 'deleted'])
        && d.keys().hasAll(['start', 'end', 'platform', 'earnings', 'tips', 'trips', 'miles', 'tolls', 'areas', 'notes', 'updatedAt', 'deleted'])
        && d.start is string && d.start.size() <= 40
        && d.end is string && d.end.size() <= 40
        && d.platform in ['Uber', 'Lyft', 'Both', 'Other']
        && money(d.earnings) && money(d.tips) && money(d.tolls)
        && d.trips is int && d.trips >= 0 && d.trips <= 500
        && money(d.miles)
        && d.areas is list && d.areas.size() <= 6
        && d.areas.hasOnly(['MCO', 'OCCC', 'Universal', 'Disney', 'Downtown', 'Other'])
        && d.notes is string && d.notes.size() <= 2000
        && d.updatedAt is int
        && d.deleted is bool;
    }

    match /users/{uid}/guides/{guideId} {
      allow get, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validGuide(request.resource.data, guideId);
    }

    match /users/{uid}/shifts/{shiftId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && shiftId.size() <= 64 && validShift(request.resource.data);
      allow delete: if isOwner(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

# ---- Server only (never prefix with VITE_) ----
# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Models tried in order. If one isn't available on your plan or hits its limit, the next is used.
GEMINI_MODELS=gemini-3.1-pro-preview,gemini-3-flash-preview,gemini-2.5-flash
# Optional: require this code (entered in the app's Settings) before research runs.
APP_ACCESS_CODE=
PORT=3000

# ---- Optional cloud backup (Firebase web config, public identifiers) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
